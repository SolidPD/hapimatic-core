{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2020", "es2022"],
    "jsx": "react",
    "rootDir": "..",
    "experimentalDecorators": true,
    "outDir": "dist",
    "noEmit": true,
    "types": ["node", "bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@xterm/xterm": ["./src/terminal/xterm-browser-types.d.ts"]
    }
  },
  "exclude": ["node_modules"],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../server/src/**/*.ts",
    "../server/src/**/*.d.ts"
  ]
}
