    "graph": {
      "id": "dup-neg",
      "version": "0.1",
      "nodes": [
        { "id": "a", "kind": "sequence" },
        { "id": "b", "kind": "sequence", "terminal": true }
      ],
      "edges": [{ "from": "a", "to": "b" }]
    }
  },

